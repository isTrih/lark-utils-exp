# PostgreSQL
DATABASE_URL=postgres://user:password@host:5432/database

# 飞书应用
LARK_APP_ID=cli_replace_me
LARK_APP_SECRET=replace_me
LARK_BASE_URL=https://open.feishu.cn

# 管理接口 Bearer Token。建议使用独立随机值。
MUTATION_API_TOKEN=replace-with-a-long-random-admin-token

# 星图同步插件共享的上传 Token。
# 前端可通过 GET /api/v1/admin/xingtu/session-upload-token 读取它并生成指定账号的插件包。
# 它会进入内部插件包，因此必须与下面的数据库加密密钥使用不同值。
XINGTU_SESSION_UPLOAD_TOKEN=replace-with-a-long-random-upload-token

# 星图登录态数据库加密密钥：标准 Base64，解码后必须恰好 32 字节。
# 这是服务端根密钥，不能进入前端或插件包。
XINGTU_SESSION_ENCRYPTION_KEY=replace-with-32-byte-standard-base64-key
XINGTU_SESSION_ENCRYPTION_KEY_ID=primary

# 服务运行
SERVER_BIND_ADDR=0.0.0.0:8080
RUST_LOG=info
LOG_DIR=/app/logs
TZ=Asia/Shanghai

# 允许跨域访问的域名规则。支持 JSON 数组、方括号逗号列表或纯逗号列表。
# 域名不填写协议、端口或路径；example.com 只匹配主域，*.example.com 只匹配子域。
# 未配置时禁用跨域响应；禁止使用全开放的 *。
CORS_DOMAIN=["example.com","*.example.com"]

# 项目日报卡片模板。仅在调用项目汇报发送接口时需要。
PROJECT_REPORT_TEMPLATE_ID=replace-with-project-report-template-id
PROJECT_REPORT_WITH_HOT_VIDEOS_TEMPLATE_ID=replace-with-hot-video-report-template-id

# 飞书数据同步插件
DATA_SYNC_PUBLIC_BASE_URL=https://your-public-domain.com
DATA_SYNC_SECRET_KEY=replace-with-the-verification-token

# 可选：API JSON 响应应用层加密。
# API_DATA_ENCRYPTION_KEY=replace-with-32-byte-standard-base64-key
# API_DATA_ENCRYPTION_KEY_ID=primary

# 可选：仅用于本地调试时在启动阶段注入星图登录态。
# XINGTU_ACCOUNT_ID=replace-with-xingtu-account-id
# XINGTU_COOKIE=passport_auth_status_ss=...
# XINGTU_CSRF_TOKEN=...
# XINGTU_SESSION_KEY=...
# XINGTU_USER_AGENT=Mozilla/5.0 ...
# SHEET_TEST_URL=https://example.larksuite.com/sheets/ExampleSpreadsheetToken
